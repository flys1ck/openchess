{
  "name": "openchess",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "devtools": "vue-devtools",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "db:gen:types": "kysely-codegen --dialect sqlite --exclude-pattern __* --out-file src/database.d.ts",
    "fmt": "oxfmt && bun run --filter '*' fmt",
    "fmt:check": "oxfmt --check && bun run --filter '*' fmt:check",
    "lint": "oxlint --fix && bun run --filter '*' lint",
    "lint:check": "oxlint && bun run --filter '*' lint:check",
    "test:bench": "vitest bench",
    "test:unit": "vitest",
    "types:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@flys1ck/lichess-client": "workspace:*",
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.5.0",
    "@tauri-apps/plugin-sql": "~2.6.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/howler": "^2.2.13",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "chessground": "^9.2.1",
    "chessops": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "howler": "^2.2.4",
    "kysely": "^0.29.6",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tw-animate-css": "^1.4.0",
    "uci-parser-ts": "^0.1.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hypothesi/tauri-mcp-cli": "^0.13.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/cpu-features": "^0.0.3",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "^26.6.5",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools": "^8.2.1",
    "cpu-features": "^0.0.10",
    "follow-redirects": "^1.16.1",
    "kysely-codegen": "^0.20.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "unzipper": "^0.12.5",
    "vite": "^8.3.4",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "cpu-features@0.0.10": "patches/cpu-features@0.0.10.patch"
  }
}
